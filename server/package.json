{
  "name": "worksuite-api",
  "version": "1.0.0",
  "description": "Worksuite backend — modular monolith on NestJS + Prisma + PostgreSQL",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate dev --name init && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@keyv/redis": "5.1.4",
    "@nestjs/bull": "12.0.0",
    "@nestjs/cache-manager": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/terminus": "12.0.0",
    "@nestjs/websockets": "^12.0.1",
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "6.0.0",
    "bull": "4.16.5",
    "cache-manager": "7.2.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "^17.4.2",
    "helmet": "8.1.0",
    "imapflow": "^2.0.1",
    "ioredis": "5.9.0",
    "keyv": "5.6.0",
    "mailparser": "^3.9.24",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "prisma": "7.6.0",
    "socket.io-client": "^4.8.3",
    "tsx": "4.23.13",
    "typescript": "^6.0.3"
  }
}
