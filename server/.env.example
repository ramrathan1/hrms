# Postgres. Prisma reads this for migrations (prisma.config.ts) and the app
# hands it to the pg Pool used by @prisma/adapter-pg.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/worksuite?schema=public"

# Pool sizing for @prisma/adapter-pg
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000

REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS=60

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

PORT=3001
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173"

# 32 random bytes, base64. Encrypts mail credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY="CHANGE_ME"
STORAGE_ROOT="./storage"
