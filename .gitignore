# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment — these hold real secrets (JWT signing keys, the mail
# encryption key, database credentials). Never commit them; .env.example
# in server/ documents what is needed.
.env
.env.*
!.env.example

# Local runtime state — anchored to the uploaded-blob directory. Unanchored,
# "storage/" matches any directory of that name at any depth, which silently
# swallowed server/src/infra/storage/.
/server/storage/
*.log

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
